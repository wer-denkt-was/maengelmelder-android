<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="de.maengelmelder.mainmodule">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="replace" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application>

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui"/>

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/gmap_api_key" />

        <activity
            android:name=".activities.QRCodeActivity"
            android:exported="false" />
        <activity
            android:name=".activities.DeepLinkDetectActivity"
            android:exported="false"
            android:noHistory="true" />
        <activity
            android:name=".activities.SplashscreenActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/app_name"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.TermsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/activity_terms"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.InternalWebActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.TestInfoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/activity_testinfo"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.IdeaOrDefectReportActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.OverviewActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.MessageProcessActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/activity_new_message"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.LoginActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/login"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/settings"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.MessageDetailActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/activity_messagedetail"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.UpdateMessageActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/activity_update_message"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.MyMessagesActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/activity_mymessages"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.LogsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/menu_logs"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.MessagesListActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/activity_messages_list"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />
        <activity
            android:name=".activities.ProfileActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/activity_profile"
            android:screenOrientation="portrait"
            android:theme="@style/MMTheme" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <service
            android:name=".service.MessageUploadService"
            android:exported="false" />
        <service
            android:name=".service.ForegroundLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>