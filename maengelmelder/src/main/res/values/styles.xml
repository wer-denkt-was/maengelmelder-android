<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DetailsTableHeader">
        <item name="android:layout_column">0</item>
        <item name="android:maxEms">7</item>
        <item name="android:layout_gravity">right</item>
        <item name="android:textColor">#444</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">3dip</item>
    </style>

    <style name="DetailsTableData">
        <item name="android:layout_column">1</item>
        <item name="android:textColor">#444</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">3dip</item>
    </style>

    <style name="MMTheme" parent="MMBaseTheme">
    </style>

    <style name="MMBaseTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:actionBarStyle">@style/MMTheme.Actionbar</item>
        <item name="actionBarTheme">@style/MMTheme.Actionbar</item>
        <item name="drawerArrowStyle">@style/MMTheme.DrawerArrowStyle</item>
        <item name="colorControlActivated">@color/mmcolor_checkbox_color</item>
    </style>

    <style name="MMTheme.ToolbarText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">24sp</item>
    </style>
    <style name="MMTheme.ToolbarSubText" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="MMTheme.Actionbar">
        <item name="android:background">@color/mmcolor_actionbar_bg</item>
        <item name="actionMenuTextColor">@color/mmcolor_actionbar_title_text</item>
        <item name="actionOverflowButtonStyle">@style/MMTheme.ActionbarOverflowStyle</item>
        <item name="colorAccent">@color/mmcolor_accent</item>
        <item name="colorControlNormal">@color/mmcolor_actionbar_control</item>
        <item name="android:textColor">@color/mmcolor_actionbar_title_text</item>
        <item name="android:textColorPrimary">@color/mmcolor_actionbar_title_text</item>
        <item name="android:textColorSecondary">@color/mmcolor_actionbar_title_text</item>
    </style>

    <style name="MMTheme.ActionbarOverflowStyle" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">@color/mmcolor_actionbar_title_text</item>
    </style>

    <style name="MMTheme.DrawerArrowStyle" parent="@style/Widget.AppCompat.DrawerArrowToggle">
        <item name="color">@color/mmcolor_actionbar_control</item>
        <item name="spinBars">true</item>
    </style>

    <style name="MMTheme.GeneralButton" parent="MMTheme.BaseButton" />
    <style name="MMTheme.GeneralButton2" parent="MMTheme.BaseButton2" />
    <style name="MMTheme.BaseButton" parent="Widget.AppCompat.Button">
        <item name="colorButtonNormal">@color/mmcolor_btn_normal_bg</item>
        <item name="android:textColor">@color/mmcolor_btn_normal_text</item>
    </style>
    <style name="MMTheme.BaseButton2" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/turkis</item>
        <item name="colorButtonNormal">@color/white</item>
    </style>

    <style name="MMTheme.GeneralImageButton" parent="MMTheme.BaseImageButton"/>
    <style name="MMTheme.BaseImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="colorButtonNormal">@color/mmcolor_btn_normal_bg</item>
        <item name="android:textColor">@color/mmcolor_btn_normal_text</item>
    </style>

    <style name="MMTheme.SmallHintText">
        <item name="android:textSize">8sp</item>
    </style>

    <style name="MMTheme.PeferenceOverlay" parent="@style/PreferenceThemeOverlay">

    </style>


</resources>