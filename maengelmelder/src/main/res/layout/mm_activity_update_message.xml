<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_weight="1"
    android:id="@+id/parentLayout"
    android:fillViewport="true">

    <include layout="@layout/mm_default_toolbar"/>

    <ScrollView
        android:layout_below="@id/toolbar"
        android:layout_margin="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/update_images_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentTop="true">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginTop="2dip"
                    android:layout_weight="1"
                    android:scaleType="center"
                    android:id="@+id/oldPicture_description"
                    android:text="@string/old_image" />

                <TextView
                    android:id="@+id/label_new_image"
                    android:accessibilityTraversalAfter="@id/old_image"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginTop="2dip"
                    android:layout_weight="1"
                    android:scaleType="center"
                    android:text="@string/new_image" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="150dip"
                android:orientation="horizontal"
                android:id="@+id/imagesLayout"
                android:layout_below="@id/update_images_layout">

                <ImageView
                    android:id="@+id/old_image"
                    android:accessibilityTraversalBefore="@id/label_new_image"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_margin="2dip"
                    android:layout_weight="1"
                    android:background="@color/lightgray"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/acc_cd_msgupdate_old_image"
                    android:src="@drawable/add_photo" />

                <ImageView
                    android:id="@+id/new_image"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_margin="2dip"
                    android:layout_weight="1"
                    android:background="@color/lightgray"
                    android:scaleType="center"
                    android:accessibilityLiveRegion="polite"
                    android:contentDescription="@string/acc_cd_msgupdate_new_image"
                    android:src="@drawable/add_photo" />
            </LinearLayout>

            <View
                android:importantForAccessibility="no"
                android:id="@+id/separator"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="7dp"
                android:layout_below="@id/imagesLayout"/>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:id="@+id/update_message_description"
                android:text="@string/your_comment"
                android:textSize="16sp"
                android:layout_below="@id/separator" />

            <EditText
                android:id="@+id/update_text"
                android:hint="@string/acc_msgupdate_hint_comment"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="125dip"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:layout_below="@id/update_message_description"
                android:importantForAutofill="no" />

            <LinearLayout
                android:id="@+id/error_comment"
                android:layout_below="@id/update_text"
                android:orientation="horizontal"
                android:layout_marginStart="5dip"
                android:layout_marginEnd="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/txt_warn_text_limit"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                    android:textColor="@color/red"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/txt_text_limit"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:gravity="end"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_margin="5dip"
                android:layout_below="@id/error_comment"
                android:id="@+id/attribform"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </LinearLayout>

            <CheckBox
                android:id="@+id/problem_solved_checkbox"
                android:minHeight="48dp"
                android:layout_width="fill_parent"
                android:accessibilityLiveRegion="polite"
                android:layout_height="wrap_content"
                android:text="@string/problem_solved"
                android:layout_below="@+id/attribform" />

            <Button
                android:id="@+id/update_message_button"
                android:theme="@style/MMTheme.GeneralButton"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/problem_solved_checkbox"
                android:text="@string/update_message_send_button"
                android:layout_margin="5dip" />

        </RelativeLayout>
    </ScrollView>


    <RelativeLayout
        android:id="@+id/loading_layout"
        android:visibility="invisible"
        android:background="@color/darkgray_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/loading"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/loading_text"
            android:gravity="center"
            android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
            android:textColor="@color/white"
            android:text="@string/info_messsage_uploading"
            android:layout_below="@id/loading"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </RelativeLayout>
</RelativeLayout>