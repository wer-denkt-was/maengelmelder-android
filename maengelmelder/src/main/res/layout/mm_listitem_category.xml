<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:id="@+id/parent"
    android:padding="10dp">

    <View
        android:importantForAccessibility="no"
        android:id="@+id/padding"
        android:layout_width="30dp"
        android:layout_height="1dp"
        />

    <ImageView
        android:id="@+id/cat_icon"
        android:focusable="false"
        android:layout_toEndOf="@id/padding"
        android:src="@drawable/mm_marker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_marginStart="15dp"
        android:layout_toEndOf="@id/cat_icon"
        android:layout_toStartOf="@id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:id="@+id/cat_title"
            style="@android:style/TextAppearance.DeviceDefault.Medium"
            android:focusable="false"
            android:drawablePadding="8dp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:focusable="false"
            android:id="@+id/cat_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:focusable="false"
            android:visibility="gone"
            android:id="@+id/cat_rubric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView
        android:focusable="true"
        android:id="@+id/info"
        android:contentDescription="@string/acc_cd_categoryitemlist_more"
        android:visibility="gone"
        android:layout_margin="5dp"
        android:src="@android:drawable/ic_menu_info_details"
        android:layout_alignParentEnd="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</RelativeLayout>