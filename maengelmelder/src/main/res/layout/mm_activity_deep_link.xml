<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.DeepLinkDetectActivity">

    <ImageView
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/mm_splashscreen"/>

    <RelativeLayout
        android:padding="20dp"
        android:contentDescription="@string/deeplink_loading_message"
        android:layout_marginBottom="80dp"
        android:background="@color/darkgray_transparent"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <ProgressBar
            android:id="@+id/deeplink_progressbar"
            android:importantForAccessibility="no"
            android:layout_width="45dp"
            android:layout_height="45dp" />
        <TextView
            android:layout_centerVertical="true"
            android:textColor="@color/white"
            android:importantForAccessibility="no"
            android:layout_toEndOf="@id/deeplink_progressbar"
            android:layout_marginStart="15dp"
            android:textSize="20sp"
            android:text="@string/deeplink_loading_message"
            android:id="@+id/deeplink_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </RelativeLayout>
</RelativeLayout>